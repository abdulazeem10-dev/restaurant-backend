# Required API/database configuration
MONGODB_URI=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
FRONTEND_ORIGIN=http://127.0.0.1:5500

# Optional customer authentication providers
GOOGLE_CLIENT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional order and password-reset email alerts (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Optional customer SMS order alerts (Twilio Messaging)
TWILIO_MESSAGING_SERVICE_SID=
# Use a Twilio phone number only if no Messaging Service SID is configured.
TWILIO_FROM_NUMBER=

# Optional Razorpay checkout/webhook integration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
